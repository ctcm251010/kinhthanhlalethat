---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import defaultArticleHero from '@/assets/hero-reading.png';

interface Props {
  title: string;
  description: string;
  topicTitle: string;
  topicSlug: string;
  publishedLabel: string;
  updatedLabel?: string | undefined;
  author?: string | undefined;
  coverImage?: ImageMetadata | undefined;
  seoTitle?: string | undefined;
  seoDescription?: string | undefined;
}

const {
  title,
  description,
  topicTitle,
  topicSlug,
  publishedLabel,
  updatedLabel,
  author,
  coverImage,
  seoTitle,
  seoDescription,
} = Astro.props;
const heroImage = coverImage ?? defaultArticleHero;
---

<BaseLayout title={seoTitle ?? title} description={seoDescription ?? description} article>
  <article class="article-shell">
    <header class="article-hero">
      <Image class="article-hero-image" src={heroImage} alt="" loading="eager" />
      <div class="article-hero-shade" aria-hidden="true"></div>
      <div class="article-hero-content page-shell">
        <a class="article-topic" href={`/le-that/${topicSlug}/`}>{topicTitle}</a>
        <h1>{title}</h1>
        <div class="article-meta">
          {author && <span>{author}</span>}
          <span>Đăng {publishedLabel}</span>
          {updatedLabel && <span>Cập nhật {updatedLabel}</span>}
        </div>
      </div>
    </header>

    <div class="article-body page-shell">
      <p class="article-lead">{description}</p>
      <div class="prose">
        <slot />
      </div>
      <slot name="after-article" />
    </div>
  </article>
</BaseLayout>
