---
import { mainNavigation, siteConfig } from '@/config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <a class="brand footer-brand" href="/">
        <span class="brand-mark" aria-hidden="true">LT</span>
        <span>{siteConfig.name}</span>
      </a>
      <p>{siteConfig.description}</p>
    </div>
    <nav aria-label="Điều hướng cuối trang">
      {mainNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
  <div class="footer-bottom">© {year} {siteConfig.name}. Nội dung mẫu đang được hoàn thiện.</div>
</footer>
