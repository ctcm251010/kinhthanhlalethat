---
import { mainNavigation, siteConfig } from '@/config/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name} — Trang chủ`}>
      <span class="brand-mark" aria-hidden="true">LT</span>
      <span>{siteConfig.name}</span>
    </a>
    <nav class="desktop-nav" aria-label="Điều hướng chính">
      {
        mainNavigation.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <details class="mobile-menu">
      <summary aria-label="Mở menu điều hướng">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </summary>
      <nav aria-label="Điều hướng trên thiết bị di động">
        {
          mainNavigation.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
