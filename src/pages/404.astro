---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Không tìm thấy trang" noindex>
  <div class="page-shell not-found">
    <div>
      <p class="eyebrow">Lỗi 404</p>
      <h1>Trang này không tồn tại.</h1>
      <p>Đường dẫn có thể đã thay đổi hoặc nội dung đang được biên tập.</p>
      <a class="button button-primary" href="/">Về trang chủ</a>
    </div>
  </div>
</BaseLayout>
